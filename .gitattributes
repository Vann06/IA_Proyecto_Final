# Auto-detect text files y normalizar line endings a LF en el repo
* text=auto eol=lf

# ── Source (LF forzado) ────────────────────────────────────
*.py        text eol=lf diff=python
*.pyi       text eol=lf diff=python
*.ipynb     text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
*.cfg       text eol=lf
*.toml      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.json      text eol=lf
*.csv       text eol=lf
*.tsv       text eol=lf

# ── Shell scripts ──────────────────────────────────────────
*.sh        text eol=lf
*.bash      text eol=lf

# ── Windows (CRLF) ─────────────────────────────────────────
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# ── Binarios (no diff, no merge) ───────────────────────────
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.svg       binary
*.pdf       binary
*.zip       binary
*.gz        binary
*.tar       binary
*.7z        binary
*.pkl       binary
*.pickle    binary
*.npy       binary
*.npz       binary
*.h5        binary
*.pt        binary
*.pth       binary
*.ckpt      binary

# ── Jupyter: diff legible ──────────────────────────────────
# Limpia outputs/metadata en diffs (requiere nbstripout instalado)
*.ipynb     filter=nbstripout
*.ipynb     diff=ipynb

# ── linguist (GitHub stats) ────────────────────────────────
notebooks/* linguist-documentation
results/*   linguist-generated
